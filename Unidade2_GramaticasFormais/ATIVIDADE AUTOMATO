## 3. Implementação em Python

```python
import re

# Regex utilizada para validação dos e-mails
padrao_email = (
    r"^(?!\.)(?!.*\.\.)(?!.*\.@)"
    r"[A-Za-z0-9_+-]+(?:\.[A-Za-z0-9_+-]+)*"
    r"@"
    r"(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\.)+"
    r"[A-Za-z]{2,}$"
)


def motivo_invalido(email):

    # Verifica a quantidade do símbolo @
    if email.count("@") == 0:
        return "Não possui o símbolo @."

    if email.count("@") > 1:
        return "Possui mais de um símbolo @."

    usuario, dominio = email.split("@")

    # Verificações do usuário
    if usuario == "":
        return "Não possui nome de usuário antes do @."

    if usuario.startswith("."):
        return "O usuário não pode começar com ponto."

    if usuario.endswith("."):
        return "O usuário não pode terminar com ponto."

    if ".." in usuario:
        return "O usuário não pode possuir dois pontos consecutivos."

    if not re.fullmatch(r"[A-Za-z0-9._+-]+", usuario):
        return "O usuário possui caracteres não permitidos."

    # Verificações do domínio
    if dominio == "":
        return "Não possui domínio depois do @."

    if "." not in dominio:
        return "O domínio não possui uma extensão."

    partes_dominio = dominio.split(".")

    # Verifica se existem partes vazias
    if "" in partes_dominio:
        return "O domínio possui uma parte vazia."

    # Verifica as partes do domínio
    for parte in partes_dominio[:-1]:

        if parte.startswith("-"):
            return "Uma parte do domínio começa com hífen."

        if parte.endswith("-"):
            return "Uma parte do domínio termina com hífen."

        if not re.fullmatch(r"[A-Za-z0-9-]+", parte):
            return "O domínio possui caracteres não permitidos."

    # Verifica a extensão
    extensao = partes_dominio[-1]

    if len(extensao) < 2:
        return "A extensão deve possuir pelo menos duas letras."

    if not extensao.isalpha():
        return "A extensão deve possuir somente letras."

    return "O endereço não corresponde ao formato esperado."


emails_validos = []
emails_invalidos = []

print("VALIDADOR DE E-MAILS")
print("--------------------")

# Solicitação de cinco e-mails
for i in range(5):

    email = input(f"Digite o {i + 1}º endereço de e-mail: ").strip()

    if re.fullmatch(padrao_email, email):
        emails_validos.append(email)

    else:
        motivo = motivo_invalido(email)
        emails_invalidos.append((email, motivo))


# Resultado
print("\nE-MAILS VÁLIDOS")
print("----------------")

if emails_validos:

    for email in emails_validos:
        print(email)

else:
    print("Nenhum e-mail válido.")


print("\nE-MAILS INVÁLIDOS")
print("------------------")

if emails_invalidos:

    for email, motivo in emails_invalidos:
        print(f"{email} -> {motivo}")

else:
    print("Nenhum e-mail inválido.")
```

